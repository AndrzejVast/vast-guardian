[Unit]
Description=Vast Guardian Collector
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=@GUARDIAN_USER@
WorkingDirectory=@REPO_PATH@
EnvironmentFile=@ENV_FILE@
EnvironmentFile=-/etc/vast-guardian/telegram.env
ExecStart=/usr/bin/python3 @REPO_PATH@/collector/loop.py
Restart=always
RestartSec=5

[Install]
WantedBy=multi-user.target
