[Unit]
Description=Vast Guardian Daily Heartbeat
After=network-online.target
Wants=network-online.target

[Service]
Type=oneshot
User=@GUARDIAN_USER@
WorkingDirectory=@REPO_PATH@
EnvironmentFile=@ENV_FILE@
EnvironmentFile=-/etc/vast-guardian/telegram.env
ExecStart=/usr/bin/python3 @REPO_PATH@/watchdog/heartbeat.py
