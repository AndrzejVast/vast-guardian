# Copy to /etc/vast-guardian/guardian.env. Keep the real file outside Git.
# The installer creates this file with mode 0600 and never overwrites it.
VAST_GUARDIAN_ROLE=central
VAST_GUARDIAN_HOST_KEY=replace-with-hostname
VAST_GUARDIAN_CENTRAL_URL=
VAST_GUARDIAN_INGEST_TOKEN=
VAST_GUARDIAN_TELEGRAM_BOT_TOKEN=
VAST_GUARDIAN_TELEGRAM_CHAT_ID=
